# Variables de entorno para correr n8n localmente (copiar a .env, no versionar).
# N8N_WEBHOOK_SECRET debe ser igual al de Backend/api/.env para que las
# firmas HMAC hacia agent-runs/* sean validas.
N8N_WEBHOOK_SECRET=change-me-in-production
DJANGO_API_URL=http://127.0.0.1:8000/api/v1

# Alma usa este modelo para responder en el workflow "Orquestador - Chat con Alma".
OPENAI_API_KEY=

# Clave usada por n8n para cifrar credenciales guardadas en su base local.
N8N_ENCRYPTION_KEY=reviive-dev-encryption-key-change-me

# Permite leer $env.* en expresiones/Code nodes (usado para DJANGO_API_URL).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Se completa solo despues de crear la API key personal en n8n (ver README).
N8N_API_KEY=
