    {
      "id": "calcular-nuevo-offset",
      "name": "Calcular nuevo offset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 140],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Rama independiente de 'Procesar actualizaciones': libera el bloqueo\n// exactamente una vez por ejecucion, sin importar si hubo 0, 1 o N\n// mensajes nuevos (si se encadenara despues del procesamiento por\n// mensaje, con 0 mensajes nunca se ejecutaria nada y el bloqueo\n// quedaria tomado para siempre).\nconst resp = $json;\nconst updates = (resp && resp.result) || [];\nlet maxUpdateId = 0;\nfor (const u of updates) { if (u.update_id > maxUpdateId) maxUpdateId = u.update_id; }\nreturn [{ json: { nuevoOffset: updates.length ? maxUpdateId + 1 : null } }];"
      }
    },
    {
      "id": "construir-cuerpo-liberar",
      "name": "Construir cuerpo liberar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 140],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $json.nuevoOffset != null ? { ultimo_update_id: $json.nuevoOffset } : {};\nreturn [{ json: { bodyString: JSON.stringify(body) } }];"
      }
    },
    {
      "id": "firmar-liberar",
      "name": "Firmar liberar",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [1920, 140],
      "parameters": {
        "action": "hmac",
        "binaryData": false,
        "type": "SHA256",
        "value": "={{ $json.bodyString }}",
        "dataPropertyName": "signature",
