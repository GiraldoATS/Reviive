    {
      "id": "construir-mensaje-con-adjunto",
      "name": "Construir mensaje con adjunto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, -280],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const original = $('Procesar actualizaciones').item.json;\nconst base64 = $json.base64 || '';\nconst mime = original.tipo_adjunto === 'imagen' ? 'image/jpeg'\n  : original.tipo_adjunto === 'audio' ? 'audio/ogg'\n  : 'video/mp4';\nconst nombreArchivo = original.tipo_adjunto === 'imagen' ? 'foto.jpg'\n  : original.tipo_adjunto === 'audio' ? 'nota-de-voz.ogg'\n  : 'video.mp4';\n\nreturn {\n  json: {\n    chat_id: original.chat_id,\n    texto: original.texto,\n    telegram_username: original.telegram_username,\n    nombre: original.nombre,\n    // Si la descarga fallo (onError continueRegularOutput), base64 queda\n    // vacio y se manda sin adjunto en vez de romper el mensaje completo.\n    adjunto: base64 ? { tipo: original.tipo_adjunto, base64: `data:${mime};base64,${base64}`, nombre: nombreArchivo } : null,\n  },\n};"
      }
    },
    {
      "id": "construir-mensaje-sin-adjunto",
      "name": "Construir mensaje sin adjunto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, -20],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "return {\n  json: {\n    chat_id: $json.chat_id,\n    texto: $json.texto,\n    telegram_username: $json.telegram_username,\n    nombre: $json.nombre,\n    adjunto: null,\n  },\n};"
