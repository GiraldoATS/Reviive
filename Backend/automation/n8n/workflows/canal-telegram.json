    },
    {
      "id": "procesar-actualizaciones",
      "name": "Procesar actualizaciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, -140],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// getUpdates devuelve {ok, result: [...]} (un objeto, no un array), asi\n// que aqui NO aplica el problema de n8n repartiendo un array top-level\n// (ver 'Evaluar rafaga' en orquestador-chat-alma.json para ese caso).\n// El avance del offset ya NO se maneja aqui (ver 'Calcular nuevo offset'\n// + el bloqueo real en Django) -- esta rama solo construye los mensajes.\nconst resp = $json;\nconst updates = (resp && resp.result) || [];\nconst items = [];\n\nfor (const update of updates) {\n  const msg = update.message;\n  if (!msg) continue;\n\n  let tipoAdjunto = null;\n  let fileId = null;\n  if (Array.isArray(msg.photo) && msg.photo.length) {\n    tipoAdjunto = 'imagen';\n    fileId = msg.photo[msg.photo.length - 1].file_id; // la de mayor resolucion\n  } else if (msg.voice) {\n    tipoAdjunto = 'audio';\n    fileId = msg.voice.file_id;\n  } else if (msg.audio) {\n    tipoAdjunto = 'audio';\n    fileId = msg.audio.file_id;\n  } else if (msg.video) {\n    tipoAdjunto = 'video';\n    fileId = msg.video.file_id;\n  }\n\n  const texto = (typeof msg.text === 'string' && msg.text) || (typeof msg.caption === 'string' && msg.caption) || '';\n  if (!texto && !tipoAdjunto) continue; // stickers, ubicacion, contactos, etc.: fuera de alcance\n\n  items.push({\n    json: {\n      chat_id: msg.chat.id,\n      texto,\n      telegram_username: (msg.from && msg.from.username) || '',\n      nombre: (msg.from && msg.from.first_name) || '',\n      tipo_adjunto: tipoAdjunto,\n      file_id: fileId,\n    },\n  });\n}\n\nreturn items;"
      }
    },
