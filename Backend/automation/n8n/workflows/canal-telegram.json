    },
    {
      "id": "liberar-bloqueo",
      "name": "Liberar bloqueo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2160, 140],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DJANGO_API_URL }}/telegram/bloqueo/liberar",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Reviive-Signature", "value": "={{ $json.signature }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $('Construir cuerpo liberar').item.json.bodyString }}",
        "options": {}
