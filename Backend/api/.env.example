DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (crear el esquema "reviive_db" desde MySQL Workbench).
MYSQL_DATABASE=reviive_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

REDIS_URL=redis://redis:6379/0

S3_ACCESS_KEY=reviive
S3_SECRET_KEY=reviive123
S3_BUCKET=reviive-media
S3_ENDPOINT_URL=http://minio:9000

N8N_WEBHOOK_SECRET=change-me-in-production
N8N_BASE_URL=http://127.0.0.1:5678

CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL del frontend (para armar enlaces en correos, ej. restablecer clave).
FRONTEND_URL=http://localhost:3000

# Envío real de correo (recuperación de contraseña, etc). Si se dejan
# vacíos, los correos se imprimen en la consola del servidor en vez de
# enviarse -- útil para probar el flujo sin credenciales reales.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Reviive <reviivemed@gmail.com>
